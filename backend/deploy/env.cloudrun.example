# Cloud Run env inventory for the parallel/standby backend.
#
# NOTE the ASTRA_ prefix: config.py uses `env_prefix="ASTRA_"`, so every setting is read
# as ASTRA_<FIELD>. Names below are the real env var names.
#
# NAMES only — actual VALUES live in Google Secret Manager (secrets) or are passed with
# --set-env-vars (non-secrets). Never commit real values.
#
# Use deploy/migrate-secrets.py to copy the secret values straight from Railway into
# Secret Manager without them ever being printed.

# ── Secrets (Secret Manager) ────────────────────────────────────────────────
# Neon connection string, async driver + TLS:
#   postgresql+asyncpg://USER:PASSWORD@HOST-pooler.../neondb?ssl=require
# Use the POOLED (-pooler) host — Cloud Run runs many instances.
ASTRA_DATABASE_URL=
# REUSE the Railway value, or every logged-in user is signed out.
ASTRA_JWT_SECRET_KEY=
ASTRA_ANTHROPIC_API_KEY=
ASTRA_RESEND_API_KEY=
ASTRA_PAYPAL_CLIENT_ID=
ASTRA_PAYPAL_CLIENT_SECRET=
ASTRA_PAYPAL_PLAN_ID=
ASTRA_PAYPAL_WEBHOOK_ID=
ASTRA_BOOTSTRAP_ADMIN_EMAIL=
ASTRA_BOOTSTRAP_ADMIN_PASSWORD=

# ── Non-secret env (--set-env-vars) ─────────────────────────────────────────
ASTRA_ENVIRONMENT=production
# Keep the SAME domain as Railway → installed agents need no change.
ASTRA_PUBLIC_API_URL=https://api.astra.technomateai.com
ASTRA_PUBLIC_APP_URL=https://astra.technomateai.com/login
ASTRA_PRICE_PER_SEAT_CENTS=749
ASTRA_PAYPAL_SANDBOX=false
ASTRA_AGENT_UPDATE_MANIFEST_URL=https://github.com/danchi32/project-astra/releases/latest/download/manifest.json
ASTRA_AGENT_UPDATE_SIGNATURE_URL=https://github.com/danchi32/project-astra/releases/latest/download/manifest.json.sig
ASTRA_BOOTSTRAP_ORG_NAME=Astra Demo
# Keep EMPTY — the custom domain resolves, so no hosts pin is needed.
ASTRA_AGENT_BACKEND_IP=
# Cloud Run only: migrations run via the astra-migrate Job, not per instance.
RUN_MIGRATIONS_ON_START=false

# ── Hardening knobs (defaults are already production-sane) ──────────────────
# Pool: total connections against Postgres = (pool + overflow) x instance count.
# pre_ping is REQUIRED on Neon — it scales compute to zero after ~5 min idle and
# restarts weekly, so pooled connections go dead.
ASTRA_DB_POOL_SIZE=5
ASTRA_DB_MAX_OVERFLOW=10
ASTRA_DB_POOL_RECYCLE_SECONDS=300
ASTRA_DB_POOL_PRE_PING=true
# Raw telemetry is pruned per device on ingest; history lives in telemetry_daily_rollups.
# 0 disables pruning. The floor keeps the newest N rows whatever their age.
ASTRA_TELEMETRY_RETENTION_DAYS=7
ASTRA_TELEMETRY_KEEP_MIN_SNAPSHOTS=60
# Agent rate limit: LOG-ONLY until you've watched real fleet traffic. A healthy agent
# makes ~6 req/min, so 120 only ever catches a stuck retry loop.
ASTRA_AGENT_RATE_LIMIT_ENABLED=true
ASTRA_AGENT_RATE_LIMIT_ENFORCE=false
ASTRA_AGENT_RATE_LIMIT_REQUESTS=120
ASTRA_AGENT_RATE_LIMIT_WINDOW_SECONDS=60

# ── Not used by this backend (verified in code) ─────────────────────────────
# Redis  — no redis client anywhere; the semantic cache is a DB table.
# Qdrant — only referenced in a comment; knowledge search does not use it.
# CORS   — unset on Railway too: the portal calls the API through its own
#          Next.js rewrite (same-origin), so no CORS entry is required.
