# Cloud Run env inventory for the parallel/standby backend.
# NAMES only — put the actual VALUES in Google Secret Manager (secrets) or
# --set-env-vars (non-secrets). Never commit real values.

# ── Required ────────────────────────────────────────────────────────────────
# Neon connection string, async driver + TLS:
#   postgresql+asyncpg://USER:PASSWORD@HOST/astra?ssl=require
DATABASE_URL=            # secret
JWT_SECRET_KEY=          # secret — REUSE the Railway value so sessions survive the flip
PUBLIC_API_URL=https://api.technomateai.com     # keep the same domain → agents unaffected
PUBLIC_APP_URL=https://astra.technomateai.com
CORS_ORIGINS=https://astra.technomateai.com
AGENT_BACKEND_IP=        # keep EMPTY (custom domain resolves; no host-pin)

# Cloud Run only: migrations run via the astra-migrate Job, not per instance.
RUN_MIGRATIONS_ON_START=false

# ── Infra ───────────────────────────────────────────────────────────────────
REDIS_URL=               # Upstash (secret)
QDRANT_URL=              # Qdrant Cloud host (secret)
QDRANT_API_KEY=          # secret

# ── Auto-update (same domain → unchanged; signing key stays in GitHub) ───────
AGENT_UPDATE_MANIFEST_URL=
AGENT_UPDATE_SIGNATURE_URL=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=          # secret  (or the SMTP_* set below)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=          # secret
# EMAIL_FROM=

# ── Billing (webhooks keep working since the domain is unchanged) ────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=     # secret
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET= # secret
# PADDLE_API_KEY=        # secret
# PADDLE_PRICE_ID=
# PADDLE_WEBHOOK_SECRET= # secret

# ── AI ──────────────────────────────────────────────────────────────────────
# your model provider key(s)
