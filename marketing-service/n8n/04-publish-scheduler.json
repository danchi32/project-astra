{
  "name": "ASTRA 04 — Publish what is due",
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "none",
    "saveExecutionProgress": false
  },
  "nodes": [
    {
      "id": "trigger",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -160,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "publish",
      "name": "Publish anything due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://astra-marketing-fmuizr4sda-as.a.run.app/api/v1/content/publish-due",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"actor\": \"scheduler\"}",
        "options": {
          "timeout": 300000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ASTRA admin token"
        }
      }
    },
    {
      "id": "worth_saying",
      "name": "Anything to say?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        280,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "version": 2,
            "typeValidation": "loose"
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "c1",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 400
            },
            {
              "id": "c2",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ $json.body.considered }}",
              "rightValue": 0
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "report",
      "name": "Report what went out",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        520,
        -100
      ],
      "parameters": {
        "chatId": "1140193092",
        "text": "={{ $json.statusCode >= 400 ? '⚠️ Publisher could not run — HTTP ' + $json.statusCode : $json.body.summary }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "ASTRA marketing bot"
        }
      }
    },
    {
      "id": "quiet",
      "name": "Nothing was due",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        520,
        100
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "Publish anything due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Publish anything due": {
      "main": [
        [
          {
            "node": "Anything to say?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything to say?": {
      "main": [
        [
          {
            "node": "Report what went out",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing was due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
