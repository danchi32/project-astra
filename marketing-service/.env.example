# ASTRA Marketing Service — local configuration.
# Copy to .env and fill in. Every variable takes the ASTRA_MKT_ prefix, deliberately
# different from the product backend's ASTRA_ so a stray shell variable can never point
# this service at the customer database.

# ── Required ───────────────────────────────────────────────────────────────────
# A DIFFERENT database from the product's. postgres:// and postgresql:// are both fine —
# the async driver is substituted for you.
ASTRA_MKT_DATABASE_URL=postgresql://user:password@host/astra_marketing

# ── Closed until set (these two fail shut, not open) ───────────────────────────
# Shared with website/hostinger/mail-config.php. Must be byte-identical there.
#   Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
ASTRA_MKT_INTAKE_SECRET=
# Bearer token for the endpoints that return names, emails and phone numbers.
ASTRA_MKT_ADMIN_TOKEN=

# ── Inert until set (everything below degrades gracefully) ─────────────────────
ASTRA_MKT_ENVIRONMENT=development
ASTRA_MKT_LOG_LEVEL=INFO

# n8n production webhook that scores, notifies and syncs to CRM.
ASTRA_MKT_N8N_LEAD_WEBHOOK_URL=
ASTRA_MKT_N8N_WEBHOOK_SECRET=

# Telegram lead alerts. Both are needed before anything is sent.
#   Token: message @BotFather, /newbot
#   Chat IDs: message your bot, then open
#     https://api.telegram.org/bot<TOKEN>/getUpdates and read result[].message.chat.id
# Comma-separated, so a second person can be added without a deploy.
ASTRA_MKT_TELEGRAM_BOT_TOKEN=
ASTRA_MKT_TELEGRAM_CHAT_IDS=

# Lead scoring. Unset falls back to the rules-only score, which is designed to be
# good enough to ship without a key.
ASTRA_MKT_ANTHROPIC_API_KEY=
ASTRA_MKT_SCORING_MODEL=claude-haiku-4-5
ASTRA_MKT_DRAFTING_MODEL=claude-sonnet-5

# Zoho Bigin. Note the .in domains — an India-region account is not on .com, and using
# the wrong one returns a confusing 401 rather than a redirect.
ASTRA_MKT_BIGIN_CLIENT_ID=
ASTRA_MKT_BIGIN_CLIENT_SECRET=
ASTRA_MKT_BIGIN_REFRESH_TOKEN=
ASTRA_MKT_BIGIN_API_DOMAIN=https://www.zohoapis.in
ASTRA_MKT_BIGIN_ACCOUNTS_DOMAIN=https://accounts.zoho.in

# Acknowledgement email. Resend's HTTPS API is tried first (works on hosts that block
# outbound SMTP); SMTP is the fallback and is what the existing Hostinger sales@ mailbox
# uses. Set one or the other — with neither, no acknowledgement is sent.
ASTRA_MKT_RESEND_API_KEY=
ASTRA_MKT_SMTP_HOST=
ASTRA_MKT_SMTP_PORT=465
ASTRA_MKT_SMTP_USER=
ASTRA_MKT_SMTP_PASSWORD=
ASTRA_MKT_EMAIL_FROM=ASTRA <sales@technomateai.com>
ASTRA_MKT_BOOKING_URL=https://cal.com/astraai/30min
ASTRA_MKT_SITE_URL=https://technomateai.com
