<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Allow the signed-release CI (Linux runner) to cross-build this Windows-target
         service; publish stays win-x64. No effect when building on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>AstraAgent.Service</RootNamespace>
    <AssemblyName>AstraAgent.Service</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AstraAgent.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The pinned update-signing public key, embedded so it ships inside the binary. -->
    <EmbeddedResource Include="Update\update-signing-public.pem">
      <LogicalName>AstraAgent.Service.Update.update-signing-public.pem</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- Phase 3 · D3: the browser extension's native host (savio-guard-host.exe) ships beside the
       service. It is published into the same folder, with the same runtime and self-contained
       setting, by every publish of this project: the release workflow, Build-AstraAgent.ps1 and
       -BuildFromSource alike. No packaging script needs to know it exists. The service registers it
       with the browsers only when the org's AI Guard policy asks for the extension. -->
  <Target Name="PublishGuardHost" AfterTargets="Publish">
    <MSBuild Projects="..\AstraAgent.GuardHost\AstraAgent.GuardHost.csproj" Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir);Version=$(Version);_GuardHostPublish=true" />
  </Target>

</Project>
